diff --git a/yb_cmake/CMakeLists.txt b/yb_cmake/CMakeLists.txt
new file mode 100644
--- /dev/null
+++ b/yb_cmake/CMakeLists.txt
@@ -0,0 +1,49 @@
+# Builds the parts of tcmalloc that YugabyteDB links against. The upstream top-level CMakeLists.txt
+# is not used because it fetches googletest, Abseil, protobuf, re2, benchmark and fuzztest at HEAD.
+# Abseil comes from the source directory given by ABSL_SRC_DIR instead.
+cmake_minimum_required(VERSION 3.24)
+project(yb_tcmalloc CXX C ASM)
+
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+set(ABSL_PROPAGATE_CXX_STD ON)
+set(ABSL_BUILD_TESTING OFF CACHE BOOL "" FORCE)
+set(ABSL_BUILD_TEST_HELPERS OFF CACHE BOOL "" FORCE)
+set(ABSL_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
+add_subdirectory(${ABSL_SRC_DIR} absl EXCLUDE_FROM_ALL)
+
+set(tcmalloc_SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/..)
+
+# Only tests and benchmarks depend on these, and those are not built.
+foreach(target GTest::gtest GTest::gmock GTest::gtest_main GTest::gmock_main
+               benchmark::benchmark benchmark::benchmark_main
+               fuzztest::fuzztest fuzztest::fuzztest_gtest_main
+               protobuf::libprotobuf protobuf::protoc re2::re2)
+  add_library(${target} INTERFACE IMPORTED)
+endforeach()
+
+include(${tcmalloc_SOURCE_DIR}/tcmalloc/tcmalloc_helpers.cmake)
+include(${tcmalloc_SOURCE_DIR}/tcmalloc/tcmalloc_variants.cmake)
+function(tcmalloc_cc_test)
+endfunction()
+function(tcmalloc_cc_binary)
+endfunction()
+function(tcmalloc_cc_test_variants)
+endfunction()
+function(tcmalloc_cc_binary_variants)
+endfunction()
+function(create_percpu_tcmalloc_testsuite)
+endfunction()
+
+add_subdirectory(${tcmalloc_SOURCE_DIR}/tcmalloc/internal tcmalloc/internal EXCLUDE_FROM_ALL)
+add_subdirectory(${tcmalloc_SOURCE_DIR}/tcmalloc tcmalloc EXCLUDE_FROM_ALL)
+
+# Building this target builds exactly the tcmalloc libraries that a static link of
+# tcmalloc::tcmalloc and tcmalloc::malloc_extension needs. It is a shared library rather than an
+# executable so that it does not pull in a sanitizer runtime with its own malloc.
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/yb_tcmalloc_closure.cc
+     "#include \"tcmalloc/malloc_extension.h\"\n"
+     "size_t YbTcmallocClosure() {\n"
+     "  return tcmalloc::MallocExtension::GetNumericProperty(\"x\").value_or(0);\n"
+     "}\n")
+add_library(yb_tcmalloc_closure SHARED ${CMAKE_CURRENT_BINARY_DIR}/yb_tcmalloc_closure.cc)
+target_link_libraries(yb_tcmalloc_closure PRIVATE tcmalloc::tcmalloc tcmalloc::malloc_extension)
